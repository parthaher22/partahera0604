# Supabase project: E-GramPanchayat (ref spknqgeqoschbtlwzhxj)
SUPABASE_URL=https://spknqgeqoschbtlwzhxj.supabase.co

# Project Settings -> API -> service_role key. NEVER expose this to a frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-dashboard

# Used only if you also want a client-side Supabase instance for direct/public reads.
SUPABASE_ANON_KEY=your-anon-publishable-key-from-supabase-dashboard

# Secret used to sign the backend's own login JWTs (generate a long random string)
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins for CORS
# - localhost + 127.0.0.1 variants for Live Server (5500), python http.server (8001), Vite (5173), CRA (3000).
# - "null" allows the frontend opened directly via file:// (double-clicking index.html).
# - For pure local dev you may use * (any origin).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://localhost:8001,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5500,http://127.0.0.1:8001,null
